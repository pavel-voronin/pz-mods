{
  "schema": 1,
  "id": "native-diagonal-city",
  "description": "Native-only NoSave diagonal city; prepared static native world-map textures. First and repeat are separate, 90 seconds each at 80 km/h. Ordinary native simulation/population/scripts. Not OS-cold. HUD snapshots 5 Hz, 31 x 31 cells of 8 tiles with loaded/unloaded history. Content counts measured at object attachment, including upper-floor squares.",
  "spawn": {
    "x": 12200,
    "y": 3000,
    "z": 0
  },
  "sandbox": {
    "Zombies": 3,
    "StartMonth": 7,
    "StartDay": 9,
    "StartTime": 2
  },
  "steps": [
    {
      "command": "native.frameRate",
      "fps": 60,
      "uncapped": false,
      "vsync": false
    },
    {
      "command": "native.time",
      "hour": 12,
      "freeze": true
    },
    {
      "command": "native.weather",
      "fog": 0,
      "rain": 0,
      "cloud": 0,
      "wind": 0
    },
    {
      "command": "native.baselinePrepare",
      "timeout": 30
    },
    {
      "command": "native.wait",
      "seconds": 3
    },
    {
      "command": "native.wait",
      "seconds": 20
    },
    {
      "command": "native.baseline",
      "name": "city-first",
      "dx": -0.7071067811865475,
      "dy": -0.7071067811865475,
      "seconds": 90,
      "timeout": 120
    },
    {
      "command": "native.wait",
      "seconds": 8
    },
    {
      "command": "native.baseline",
      "name": "city-repeat",
      "dx": 0.7071067811865475,
      "dy": 0.7071067811865475,
      "seconds": 90,
      "timeout": 120
    },
    {
      "command": "native.screenshot",
      "name": "city-completed"
    }
  ]
}
